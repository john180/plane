# Copy this file to .env before running docker compose.
# Change all secret values before exposing this deployment outside localhost.

# Public entry point
SITE_ADDRESS=:80
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
CERT_EMAIL=
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=
TRUSTED_PROXIES=0.0.0.0/0

# Django/API
SECRET_KEY=change-this-secret-key
DEBUG=0
WEB_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost
GUNICORN_WORKERS=2
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute
HARD_DELETE_AFTER_DAYS=60
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=

# PostgreSQL
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane
POSTGRES_PORT=5432
DATABASE_URL=postgresql://plane:plane@plane-db:5432/plane

# Redis/Valkey
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

# RabbitMQ/Celery broker
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:plane@plane-mq:5672/plane

# S3-compatible object storage
USE_MINIO=1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
BUCKET_NAME=uploads
MINIO_ENDPOINT_SSL=0

# Plane apps base paths. Empty base URLs keep browser traffic same-origin via Caddy.
APP_BASE_URL=http://localhost
APP_BASE_PATH=
ADMIN_BASE_URL=http://localhost
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=http://localhost
SPACE_BASE_PATH=/spaces
LIVE_BASE_URL=http://localhost
LIVE_BASE_PATH=/live
LIVE_SERVER_SECRET_KEY=change-this-live-secret

# Frontend build-time public envs. Leave base URLs empty for same-origin routing.
VITE_API_BASE_URL=
VITE_API_BASE_PATH=/api
VITE_ADMIN_BASE_URL=
VITE_ADMIN_BASE_PATH=/god-mode
VITE_SPACE_BASE_URL=
VITE_SPACE_BASE_PATH=/spaces
VITE_LIVE_BASE_URL=
VITE_LIVE_BASE_PATH=/live
VITE_WEB_BASE_URL=
VITE_WEB_BASE_PATH=
VITE_WEBSITE_URL=
VITE_SUPPORT_EMAIL=

# Optional integrations
ENABLE_SMTP=0
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_FROM=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
UNSPLASH_ACCESS_KEY=
